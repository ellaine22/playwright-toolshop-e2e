{
  "name": "playwright-toolshop-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "UI and API test suite built with Playwright and TypeScript against the Practice Software Testing Toolshop",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=chromium --project=firefox",
    "test:api": "playwright test --project=api",
    "test:smoke": "playwright test --grep @smoke",
    "test:headed": "playwright test --project=chromium --headed",
    "report": "playwright show-report",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "eslint-plugin-playwright": "^2.12.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
